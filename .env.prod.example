# Шаблон .env для прод-сервера (docker-compose.prod.yml).
# На сервере: cp .env.prod.example .env и заполнить все пустые значения и пароли.

# Домен, на который Caddy выпустит HTTPS-сертификат (DNS A-запись должна указывать на сервер)
APP_DOMAIN=crm.example.ru

APP_NAME='Аквастиль CRM'
APP_ENV=production
# Сгенерировать: docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.ru
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_CURRENCY=RUB

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aquastyle_crm
DB_USERNAME=aquastyle_crm
# Длинные случайные пароли, например: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_SENDMAIL_PATH='/usr/bin/msmtp -t'
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=crm@yakov89.ru
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=yakov89.ru

MAIL_RECEIVER_DRIVER=sendgrid
MAIL_RECEIVER_INBOUND_TOKEN=

IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30
